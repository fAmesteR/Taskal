# Firebase web app config (public by design — safe in the client bundle
# ONLY because Firestore Security Rules enforce per-user access. See firestore.rules).
# Copy to .env and fill with your Firebase project's values (Firebase console > Project settings > Your apps).
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Optional: App Check (reCAPTCHA v3 site key). Set this AND enable App Check
# enforcement in the Firebase console to block scripted abuse / mass signup.
# Leave unset to disable App Check.
# VITE_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key
